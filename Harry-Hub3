-- 狀態
local walkSpeed = 16
local flySpeed = 50
local flying = false
local noclipEnabled = false
local minimizedState = false
local closed = false

local flightConnection
local noclipConnection
local noclipDescendantConnection
local bodyVelocity

local oldAutoRotate
local oldPlatformStand
local oldCollisions = {}

-- 取得角色
local function getCharacterParts()
    local character = player.Character
    if not character then
        return nil, nil, nil
    end

    return character,
        character:FindFirstChildOfClass("Humanoid"),
        character:FindFirstChild("HumanoidRootPart")
end

-- 驗證速度
local function parseSpeed(box, status, label)
    local n = tonumber(box.Text)

    if not n or n < 1 or n > 100000 or n % 1 ~= 0 then
        status.Text = "請輸入 1～100000 的整數"
        return nil
    end

    status.Text = label .. "：" .. n
    return n
end

walkApply.Activated:Connect(function()
    local n = parseSpeed(
        walkBox, walkStatus, "目前移動速度"
    )
    if not n then return end

    walkSpeed = n

    local _, humanoid = getCharacterParts()
    if humanoid then
        humanoid.WalkSpeed = n
    end
end)

flyApply.Activated:Connect(function()
    local n = parseSpeed(
        flyBox, flyStatus, "目前飛行速度"
    )
    if n then
        flySpeed = n
    end
end)

-- 飛行
local function stopFlying()
    flying = false

    if flightConnection then
        flightConnection:Disconnect()
        flightConnection = nil
    end

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    local _, humanoid, root = getCharacterParts()

    if humanoid then
        if oldPlatformStand ~= nil then
            humanoid.PlatformStand = oldPlatformStand
        end
        if oldAutoRotate ~= nil then
            humanoid.AutoRotate = oldAutoRotate
        end
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    flyToggle.Text = "飛行：已關閉"
    flyToggle.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
end

local function startFlying()
    local _, humanoid, root = getCharacterParts()

    if not humanoid or not root then
        flyStatus.Text = "找不到角色，請重新嘗試"
        return
    end

    oldAutoRotate = humanoid.AutoRotate
    oldPlatformStand = humanoid.PlatformStand

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "HarryHubFlightVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.P = 1e5
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = root

    flying = true
    flyToggle.Text = "飛行：已開啟"
    flyToggle.BackgroundColor3 = Color3.fromRGB(150, 25, 35)

    flightConnection = RunService.Heartbeat:Connect(function()
        if closed or not flying or not root.Parent or not bodyVelocity then
            stopFlying()
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        local cf = camera.CFrame
        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += cf.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= cf.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += cf.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= cf.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        -- 靜止時速度為零，由 BodyVelocity 抵銷重力
        bodyVelocity.Velocity = direction * flySpeed

        local look = Vector3.new(
            cf.LookVector.X, 0, cf.LookVector.Z
        )

        if look.Magnitude > 0.001 then
            root.CFrame = CFrame.lookAt(
                root.Position,
                root.Position + look.Unit
            )
        end

        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

flyToggle.Activated:Connect(function()
    if flying then
        stopFlying()
    else
        startFlying()
    end
end)

-- 穿牆：保存原本碰撞狀態，關閉時還原
local function applyNoclipToPart(character, part)
    if not noclipEnabled or not part:IsA("BasePart") then
        return
    end

    oldCollisions[character] = oldCollisions[character] or {}
    local saved = oldCollisions[character]

    if saved[part] == nil then
        saved[part] = part.CanCollide
    end

    part.CanCollide = false
end

local function applyNoclipToCharacter(character)
    if not noclipEnabled or not character then
        return
    end

    -- 先斷開舊角色的新增零件監聽
    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end

    for _, part in ipairs(character:GetDescendants()) do
        applyNoclipToPart(character, part)
    end

    -- 新增的身體零件也立即套用穿牆
    noclipDescendantConnection = character.DescendantAdded:Connect(
        function(part)
            applyNoclipToPart(character, part)
        end
    )
end

local function restoreAllCollisions()
    for character, saved in pairs(oldCollisions) do
        for part, original in pairs(saved) do
            if part and part.Parent then
                part.CanCollide = original
            end
        end

        oldCollisions[character] = nil
    end
end

local function setNoclip(enabled)
    noclipEnabled = enabled

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end

    if not enabled then
        restoreAllCollisions()

        noclipToggle.Text = "穿牆：已關閉"
        noclipToggle.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
        return
    end

    noclipToggle.Text = "穿牆：已開啟"
    noclipToggle.BackgroundColor3 = Color3.fromRGB(150, 25, 35)

    if player.Character then
        applyNoclipToCharacter(player.Character)
    end

    -- 物理更新前處理碰撞，避免每幀修改 CFrame
    noclipConnection = RunService.Stepped:Connect(function()
        if closed or not noclipEnabled then return end

        local character = player.Character
        if not character then return end

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                applyNoclipToPart(character, part)
            end
        end
    end)
end

noclipToggle.Activated:Connect(function()
    setNoclip(not noclipEnabled)
end)

-- 重生：保留 GUI、移動速度及穿牆狀態
player.CharacterAdded:Connect(function(character)
    if flying then
        stopFlying()
    end

    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid and not closed then
        humanoid.WalkSpeed = walkSpeed
    end

    if noclipEnabled and not closed then
        applyNoclipToCharacter(character)
    end
end)

